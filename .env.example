# Secrets and shared config — API keys, AI_PROVIDERS, AI_PURPOSES, AI_PRICES
# — live in the ROOT CHECKOUT's .env, not in each worktree's. `pnpm env:up`
# copies every key from the root .env into this worktree's .env, except the
# five derived keys below (APP_PORT, DB_PORT, STACKS_ENV, TEST_DB_PORT,
# TEST_DATABASE_URL), which always stay per-worktree. The root value wins
# over anything already in this worktree's .env. Rerun `pnpm env:up` after
# changing the root .env to pick up the change (spec 022).

# Database credentials the app connects with. POSTGRES_PASSWORD has no
# default — Postgres refuses to start without one. Set a real value; never
# commit the filled-in copy (it is git-ignored).
POSTGRES_USER=stacks
POSTGRES_PASSWORD=changeme
POSTGRES_DB=stacks

# Connection string the app reads. The host is `db` — the compose SERVICE
# NAME — not `localhost`. Containers reach each other by service name on
# the compose network; `localhost` inside the app container refers to the
# app container itself, not the database. This is the most common
# first-run mistake. Keep the credentials here in sync with the ones above.
DATABASE_URL=postgres://stacks:changeme@db:5432/stacks

# Connection string the TESTS use, from the HOST rather than from inside a
# container. It points at the per-worktree TEST stack (spec 020) — a
# separate, tmpfs-backed Postgres `pnpm env:up` starts and writes here
# automatically. It must differ from DATABASE_URL above: `db` is a compose
# service name that only resolves on the compose network, so a host process
# cannot use it. Without it the event-log integration tests SKIP rather than
# fail, so the suite goes green having proven nothing.
# Because tests read this first, `pnpm db:migrate` from the host also
# migrates the TEST database, not the app's. To migrate the APP database
# instead, override it for one command:
#   TEST_DATABASE_URL=postgres://stacks:changeme@localhost:$DB_PORT/stacks \
#     pnpm --filter @the-stacks/server db:migrate
# Uncomment below only if you're not using `pnpm env:up`:
# TEST_DATABASE_URL=postgres://stacks:changeme@localhost:5433/stacks

# Host port Postgres is published on, bound to 127.0.0.1 only. The host
# needs this to run integration tests against a real database; the LAN
# does not, which is why compose binds loopback rather than 0.0.0.0.
# Change it if something else already uses 5432 on your machine.
DB_PORT=5432

# Host port the per-worktree TEST stack's Postgres is published on (spec
# 020), bound to 127.0.0.1 only. `pnpm env:up` derives and writes this;
# change it if something else already uses 5433 on your machine.
TEST_DB_PORT=5433

# Host port the app is published on (and the port it listens on inside
# the container).
APP_PORT=3000

# Which stack this is (spec 010) — labels every container for `env status`/
# `env prune` and isolates the compose project (stacks-<STACKS_ENV>). Running
# `pnpm env:up` from a worktree derives this (and writes APP_PORT, DB_PORT,
# and TEST_DATABASE_URL above) for you — you don't normally set it by hand.
STACKS_ENV=default

# --- AI gateway (all optional; unset = no model features) ---
# Set these in the ROOT checkout's .env — pnpm env:up inherits them (see header above).
# Providers are named by YOU. Each has an adapter kind, a base URL, and optionally the
# NAME of the env var holding its key. No provider is built in or preferred.
# Kinds today: openai-compatible, fake. A native kind (e.g. anthropic) can be added later
# behind the same Provider interface.
# AI_PROVIDERS={"hosted":{"kind":"openai-compatible","baseUrl":"https://api.example.com/v1","apiKeyEnv":"HOSTED_API_KEY"},"local":{"kind":"openai-compatible","baseUrl":"http://localhost:11434/v1"}}
# HOSTED_API_KEY=
#
# Purposes map to a provider name and a model. op defaults to "chat".
# AI_PURPOSES={"answering":{"provider":"hosted","model":"your-chat-model"},"embedding":{"provider":"local","model":"your-embedding-model","op":"embed"}}
#
# Prices per provider/model, USD per million tokens. Unpriced calls record cost as unknown.
# AI_PRICES={"hosted/your-chat-model":{"inputPerMTok":0,"outputPerMTok":0}}

# --- Library ingestion (specs/017-ingestion-pipeline) ---
# Ceiling on a single upload's file-part size, in bytes. Default 1 GiB: real
# D&D Beyond exports run 40-310 MB, so the default leaves headroom rather
# than a tight guess. A larger upload gets 413 too_large before the body is
# read (Content-Length) or mid-stream (the file part's byte count).
# UPLOAD_MAX_BYTES=1073741824

# --- Retrieval (all optional) ---
# How library retrieval answers a question: "vector" (embeddings only), "fts"
# (keyword only), or "hybrid" (both, fused). Default: hybrid.
# RETRIEVAL_MODE=hybrid
#
# Passages returned per request, 1-50. Default: 8.
# RETRIEVAL_K=8
#
# Which AI_PURPOSES entry (op: "embed") retrieval uses to embed the question.
# Must name the same purpose ingestion (TASK-0024) used to embed the library's
# chunks, or vector/hybrid search finds nothing. Default: embedding.
# RETRIEVAL_EMBED_PURPOSE=embedding

# --- Answering (all optional; specs/018-rules-answerer) ---
# The rules answerer always calls the AI_PURPOSES entry named "answering"
# (op: "chat"). There is no env var to rename it: map "answering" to any
# provider/model in AI_PURPOSES above. Unconfigured, /library/ask returns a
# config error instead of answering.
#
# Floor a vector-only passage's similarity score must meet to be sent to the
# model, 0-1. A keyword hit is always relevant regardless of this floor.
# Default: 0.3.
# ASK_MIN_SIMILARITY=0.3

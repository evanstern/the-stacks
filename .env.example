# Database credentials the app connects with. POSTGRES_PASSWORD has no
# default — Postgres refuses to start without one. Set a real value; never
# commit the filled-in copy (it is git-ignored).
POSTGRES_USER=stacks
POSTGRES_PASSWORD=changeme
POSTGRES_DB=stacks

# Connection string the app reads. The host is `db` — the compose SERVICE
# NAME — not `localhost`. Containers reach each other by service name on
# the compose network; `localhost` inside the app container refers to the
# app container itself, not the database. This is the most common
# first-run mistake. Keep the credentials here in sync with the ones above.
DATABASE_URL=postgres://stacks:changeme@db:5432/stacks

# Host port Postgres is published on, bound to 127.0.0.1 only. The host
# needs this to run integration tests against a real database; the LAN
# does not, which is why compose binds loopback rather than 0.0.0.0.
# Change it if something else already uses 5432 on your machine.
DB_PORT=5432

# Host port the app is published on (and the port it listens on inside
# the container).
APP_PORT=3000

{"sessionId": "300f0d7c-eba6-4aaf-9e2f-1cf82d1c075d", "seq": 10, "actor": "ai:dm", "type": "narration", "payload": {"text": "The party reaches Greyhollow Ford as the light goes amber. The ferry sits chained to the near bank, the ferry-house door hangs open, and the bell that should have rung for them stays silent. The air feels like a roll of the dice.", "actionIds": []}, "payloadVersion": 1, "visibility": "public", "ts": "2026-10-26T10:18:13.489Z"}
{"sessionId": "300f0d7c-eba6-4aaf-9e2f-1cf82d1c075d", "seq": 11, "actor": "ai:dm", "type": "journal.entry.added", "payload": {"body": "The party reached the ford and searched the ferry-house.", "title": "The ferry-house", "entryId": "chron-300f0d7c-10", "sourceActionIds": []}, "payloadVersion": 1, "visibility": "public", "ts": "2026-10-26T10:18:13.505Z"}

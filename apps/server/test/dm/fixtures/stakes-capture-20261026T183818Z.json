    {
      "sessionId": "787ba795-b866-4e4d-9eb9-71176962863e",
      "seq": 175,
      "actor": "ai:dm",
      "type": "narration",
      "payload": {
        "text": "The silver symbol lands spinning, and Snag's clapper pole slaps down on it before it settles. His grin splits wider, teeth yellow in the firelight. \"Shiny! Shiny for Snag!\" He scoops it up, looping the chain around his wrist beside the clapper-strap, and does not call anything off. \"Big priest pays toll \u2014 toll don't buy girl! Toll buys *quiet*!\" He rattles the pole twice, delighted, and nods toward the fray, grin never fading. Pell strains against his bindings, watching Tamsin with wide eyes.\n\nWhat does Tamsin do?\n\nBrother Odo \u2014 Odo offers his silver holy symbol as toll to Snag in exchange for releasing Tamsin.: 1d20+3 \u2192 7 = 10 vs DC 15: failure",
        "actionIds": ["act-odo-3"]
      },
      "payloadVersion": 1,
      "visibility": "public",
      "ts": "2026-10-26T18:51:18.334Z"
    },

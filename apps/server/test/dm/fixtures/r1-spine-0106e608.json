    {
      "sessionId": "0106e608-e5f0-4ff9-89e2-16f780dbc002",
      "seq": 29,
      "actor": "ai:dm",
      "type": "talk",
      "payload": {
        "text": "Her knuckles are bone-white on the boat-hook, jaw tight, eyes flicking to the reeds every few words — whatever calm she's holding is thin.",
        "channel": "ooc",
        "characterId": null
      },
      "payloadVersion": 1,
      "visibility": "PLAYER_USER",
      "ts": "2026-11-14T02:14:38.828939+00:00"
    },
    {
      "sessionId": "0106e608-e5f0-4ff9-89e2-16f780dbc002",
      "seq": 30,
      "actor": "ai:dm",
      "type": "narration",
      "payload": {
        "text": "Last I seen 'em — reeds past the bend, three days gone. Neither come back for supper, nor the one after. Water's loud there, swallows sound. I counted the hours — three, nine, twenty-seven — till I quit countin' and come lookin' myself. Found the rope cut 'fore I found them.",
        "actionIds": []
      },
      "payloadVersion": 1,
      "visibility": "public",
      "ts": "2026-11-14T02:14:38.837214+00:00"
    },
    {

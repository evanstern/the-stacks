            {
              "kind": "addressed",
              "actorId": "odo"
            },
            {
              "kind": "overheard",
              "actorId": "wenna"
            }
          ],
          "speaker": "wenna",
          "text": "Wenna squints at the smoke and mutters into her collar. \"That is no cookfire, friar. Tell them what you smell.\"",
          "encounterId": null,
          "companionPrompts": [],
          "reason": "Odo was asked a direct question with Wenna beside him; she hands him the answer."
        }
      }

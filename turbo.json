{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@the-stacks/web#test": {
      "dependsOn": ["build"],
      "cache": false
    }
  },
  "globalEnv": [
    "APP_PORT",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "DB_PORT",
    "REQUIRE_DATABASE"
  ]
}

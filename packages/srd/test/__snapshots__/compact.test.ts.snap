// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`rule compact snapshots (shipped records) > playing-the-game.combat 1`] = `
"Combat [rule/playing-the-game.combat]
Adventurers encounter many dangerous monsters and nefarious villains. In those moments, combat often breaks out.
See: The Order of Combat, Movement and Position, Making an Attack, Cover, Ranged Attacks, Melee Attacks, Mounted Combat, Underwater Combat
SRD 5.2.1 p.13"
`;

exports[`rule compact snapshots (shipped records) > playing-the-game.d20-tests.ability-checks.difficulty-class 1`] = `
"Difficulty Class [rule/playing-the-game.d20-tests.ability-checks.difficulty-class]
Typical Difficulty Classes: Very easy | 5
Easy | 10
Medium | 15
Hard | 20
Very hard | 25
Nearly impossible | 30
The Difficulty Class of an ability check represents the task’s difficulty. The more difficult the task, the higher its DC.
+2 more
SRD 5.2.1 p.6"
`;


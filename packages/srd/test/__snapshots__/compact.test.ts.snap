exports[`snapshots > class fighter 1`] = `
"Fighter [class/fighter] d10; saves str,con; primary Strength or Dexterity
L1 Fighting Style, Second Wind, Weapon Mastery
L2 Action Surge (one use), Tactical Mind
L3 Fighter Subclass
L4 Ability Score Improvement
L5 Extra Attack, Tactical Shift
Subclass Champion
+L6-20
SRD 5.2.1 p.47"
`;

exports[`snapshots > condition prone 1`] = `
"Prone [condition/prone]
Restricted Movement: Your only movement options are to crawl or to spend an amount of movement equal to half your Speed (round down) to right yourself and thereby end the condition. If your Speed is 0, you can’t right yourself.
Attacks Affected: You have Disadvantage on attack rolls. An attack roll against you has Advantage if the attacker is within 5 feet of you.
+1 more
SRD 5.2.1 p.186"
`;


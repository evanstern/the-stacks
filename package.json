{
  "name": "the-stacks",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "test": "turbo run test",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:hooks": "node --test '.claude/hooks/*.test.mjs'",
    "check:scripts": "node --test 'scripts/*lib.test.mjs'",
    "ci:check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm check:boundaries && pnpm check:hooks && pnpm check:scripts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3"
  }
}
